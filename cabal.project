packages:
  effectful-core/*.cabal
  effectful-plugin/*.cabal
  effectful-th/*.cabal
  effectful/*.cabal

-- Ignore dependency bounds of other effect libraries.
allow-newer: cleff:*
           , freer-simple:*
           , fused-effects:*
           , polysemy:*

if impl(ghc >= 10)
  allow-newer:
    , *:base
    , *:template-haskell
  source-repository-package
    type: git
    location: https://github.com/arybczak/hashable.git
    tag: 8e193ca5308130dca1363f1c5aa91169b9c1490e
